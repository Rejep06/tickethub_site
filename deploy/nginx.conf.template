# Loaded inside the official Nginx image's http context. Only PUBLIC_HOST is substituted.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=12r/m;
log_format tickethub '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent $request_time';
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${PUBLIC_HOST};
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; try_files $uri =404; }
    location / { return 308 https://${PUBLIC_HOST}$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};
    if ($host != "${PUBLIC_HOST}") { return 444; }
    ssl_certificate /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    client_max_body_size 110m;
    client_body_timeout 180s;
    send_timeout 180s;
    access_log /var/log/nginx/access.log tickethub;
    error_log /var/log/nginx/error.log warn;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    proxy_http_version 1.1;
    proxy_set_header Host ${PUBLIC_HOST};
    proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Overwrite, do not trust a client's forged forwarding chain.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 10s;
    proxy_read_timeout 190s;
    proxy_send_timeout 190s;

    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; try_files $uri =404; }
    location ~ /\. { deny all; }
    location /static/ { alias /srv/static/; expires 1d; }
    # Public *images only*. A future ticket-file feature must NOT put private files here.
    location /media/ {
        alias /srv/media/;
        autoindex off;
        limit_except GET HEAD { deny all; }
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "public, max-age=86400";
    }
    location ~ ^/api/v1/auth/(otp/|staff/) {
        limit_req zone=login_limit burst=12 nodelay;
        limit_req_status 429;
        proxy_pass http://backend:8000;
        proxy_no_cache 1;
    }
    # No URI suffix on proxy_pass: keep the exact path, query and trailing slash.
    location /api/ { proxy_pass http://backend:8000; proxy_no_cache 1; }
    location /ops/ { proxy_pass http://backend:8000; proxy_no_cache 1; }
    location = /health/ready/ { proxy_pass http://backend:8000; }
    location = /health/live/ { proxy_pass http://backend:8000; }
    location / {
        proxy_pass http://frontend:3000;
        proxy_buffering off;
    }
}
