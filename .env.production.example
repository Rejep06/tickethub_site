# Copy via: python3 deploy/create_production_env.py your-domain.ru
# One canonical domain, without scheme/path/port. Use punycode for an IDN.
PUBLIC_HOST=example.com
DJANGO_SECRET_KEY=GENERATE_WITH_SCRIPT
POSTGRES_DB=tickethub
POSTGRES_USER=tickethub_app
POSTGRES_PASSWORD=GENERATE_WITH_SCRIPT
POSTGRES_ADMIN_PASSWORD=GENERATE_WITH_SCRIPT
# Resolve and review a real requirements.lock before building.
REQUIREMENTS_FILE=requirements.lock
RELEASE_TAG=manager-checkout-2026-10-21
WEB_WORKERS=2
NODE_IMAGE=node:24-bookworm-slim
PYTHON_IMAGE=python:3.13-slim-bookworm
POSTGRES_IMAGE=postgres:17-bookworm
NGINX_IMAGE=nginx:stable-alpine
CERTBOT_IMAGE=certbot/certbot:latest
# Replace image tags with approved @sha256 digests after the first successful test build.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_HOURS=
STAFF_NOTIFICATION_EMAILS=
# At first boot keep false until SMTP/contacts/legal documents are ready.
# Then set BOTH to true; manual checkout does not need online payments.
PUBLIC_FORMS_ENABLED=false
ORDER_INTAKE_ENABLED=false
CLIENT_ANALYTICS_ENABLED=false
