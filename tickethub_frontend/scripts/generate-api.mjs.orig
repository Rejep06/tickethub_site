// Dependency-free generator for the checked-in OpenAPI 3 schema. No invented enums.
import {readFileSync, writeFileSync} from 'node:fs';
const schema = JSON.parse(readFileSync(new URL('../docs/backend-openapi.json', import.meta.url)));
function type(s = {}) {
  let out;
  if (s.$ref) out = s.$ref.split('/').at(-1);
  else if (s.enum) out = s.enum.map(x => JSON.stringify(x)).join(' | ');
  else if (s.oneOf || s.anyOf) out = (s.oneOf || s.anyOf).map(type).join(' | ');
  else if (s.allOf) out = s.allOf.map(type).join(' & ');
  else if (s.type === 'array') out = `Array<${type(s.items)}>`;
  else if (s.type === 'object' || s.properties) {
    const props = Object.entries(s.properties || {}).map(([k,v]) => `${JSON.stringify(k)}${(s.required || []).includes(k) ? '' : '?'}: ${type(v)};`);
    if (s.additionalProperties && props.length === 0) out = `Record<string, ${s.additionalProperties === true ? 'unknown' : type(s.additionalProperties)}>`;
    else out = `{ ${props.join(' ')} }`;
  } else out = ({integer:'number', number:'number', boolean:'boolean', string:'string', null:'null'})[s.type] || 'unknown';
  return s.nullable ? `(${out}) | null` : out;
}
writeFileSync(new URL('../src/lib/api/generated.ts', import.meta.url),
  '// GENERATED by npm run generate:api. Source: attached backend OpenAPI. Do not edit.\n' +
  Object.entries(schema.components.schemas).map(([name,s]) => `export type ${name} = ${type(s)};`).join('\n') + '\n');
console.log(`Generated ${Object.keys(schema.components.schemas).length} API types`);
