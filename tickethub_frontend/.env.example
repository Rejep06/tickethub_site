# Node 24 LTS recommended. Browser sends all API requests to the same origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_ORIGIN=http://127.0.0.1:8000
# Server-only address; never prefix this with NEXT_PUBLIC.
API_INTERNAL_URL=http://127.0.0.1:8000/api/v1/
# Exact backend account emails / credentials belong to backend configuration, not here.
