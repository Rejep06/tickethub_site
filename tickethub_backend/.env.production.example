# Copy to .env.production, chmod 600, fill actual secrets and approved image digests.
# Do not copy the development .env to production.
PYTHON_IMAGE=
POSTGRES_IMAGE=
NGINX_IMAGE=
REQUIREMENTS_FILE=requirements.lock
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=
PUBLIC_HOST=
POSTGRES_DB=tickethub
POSTGRES_USER=tickethub_app
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
EMAIL_MESSAGE_DOMAIN=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_HOURS=
STAFF_NOTIFICATION_EMAILS=
PUBLIC_FORMS_ENABLED=false
ORDER_INTAKE_ENABLED=false
CLIENT_ANALYTICS_ENABLED=false
TLS_CERT_DIR=./infra/certificates
