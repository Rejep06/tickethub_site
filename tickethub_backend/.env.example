# Development template only. No real secrets in this file.
# Prefer: python3 scripts/create_local_env.py (generates .env once).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=tickethub
POSTGRES_USER=tickethub
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=development@localhost
EMAIL_MESSAGE_DOMAIN=localhost
SITE_URL=http://localhost:8000
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_HOURS=
STAFF_NOTIFICATION_EMAILS=
PUBLIC_FORMS_ENABLED=true
ORDER_INTAKE_ENABLED=true
CLIENT_ANALYTICS_ENABLED=true
REQUIRE_LEGAL_ACCEPTANCE=false
LOCAL_UID=1000
LOCAL_GID=1000
# Development image branches. No production-tested lock is claimed.
PYTHON_IMAGE=python:3.13-slim-bookworm
POSTGRES_IMAGE=postgres:17-bookworm
